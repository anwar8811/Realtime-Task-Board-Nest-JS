# Used by docker-compose.yml to bring up the full stack (postgres + backend +
# frontend) with a single `docker compose up`. Copy this file to `.env`,
# fill in real values, then run `docker compose up --build`.
#
# This is separate from backend/.env.example and frontend/.env.example,
# which are for running each app locally without Docker.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=realtime_task_board

# --- Backend -----------------------------------------------------------------
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=1h
# The browser-facing frontend URL, used for CORS - not a container-network name.
FRONTEND_ORIGIN=http://localhost:3001
# Used once, manually, to create the first admin account (see README's
# "Running with Docker" section for why this isn't `npx prisma db seed`):
#   docker compose exec backend node dist/prisma/seed.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Deliberately empty - "AI off" is a valid, expected state. The stack boots
# fine without this set; POST /tasks/summarize returns 503 until it's set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"

# --- Frontend ------------------------------------------------------------
# Baked into the frontend's JS bundle at build time (see frontend/Dockerfile) -
# changing this requires `docker compose build frontend`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:3000
