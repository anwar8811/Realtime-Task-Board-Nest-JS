DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realtime_task_board?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_ORIGIN=http://localhost:3001
# Deliberately empty — "AI off" is a valid, expected state. The app boots
# fine without this set; POST /tasks/summarize returns 503 until it's set.
# Never put a real key in this file, only in the gitignored .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
