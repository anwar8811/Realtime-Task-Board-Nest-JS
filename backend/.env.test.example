DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realtime_task_board_test?schema=public"
PORT=3000
NODE_ENV=test
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:3001
# Any non-empty placeholder works here — AiService only checks that a key is
# *present* before calling OpenRouter, and every e2e spec that exercises
# POST /tasks/summarize stubs global.fetch, so no real network call (and no
# real key) is ever needed to run the suite. Never put a real key here.
OPENROUTER_API_KEY=test-placeholder-key-never-used-for-a-real-call
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"
